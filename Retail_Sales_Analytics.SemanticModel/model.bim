        "measures": [
          {
            "name": "Total Items Sold",
            "expression": "COUNTROWS(TransactionItems_Matched)",
            "formatString": "#,##0",
            "lineageTag": "c16120d2-4408-47bb-8cbf-34be0508e781"
          },
          {
            "name": "Average Items Per Transaction",
            "expression": "DIVIDE([Total Items Sold], [Transaction Count], 0)",
            "formatString": "#,##0.00",
            "lineageTag": "1232733c-1533-43a7-9f1b-a219c1385cac"
          },
          {
            "name": "% Share of Total Items Sold",
            "expression": "DIVIDE([Total Items Sold], CALCULATE([Total Items Sold], ALLSELECTED(TransactionItems_Matched)), 0)",
            "formatString": "0.00%",
            "lineageTag": "5a20a42d-db82-48c5-bfc9-a7ce0d847dd8"
          }
        ],
        "partitions": [
          {
            "name": "TransactionItems_Matched",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Transactions,",
                "    #\"Removed Other Columns\" = Table.SelectColumns(Source, {\"ReceiptNumber\", \"Outlet\", \"Date\", \"Items\"}),",
                "    #\"Split Items to List\" = Table.TransformColumns(#\"Removed Other Columns\", {{\"Items\", Splitter.SplitTextByDelimiter(\", \", QuoteStyle.None), type list}}),",
                "    #\"Expanded Items to Rows\" = Table.ExpandListColumn(#\"Split Items to List\", \"Items\"),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Expanded Items to Rows\", {{\"Items\", \"ItemName\"}}),",
                "    #\"Trimmed Text\" = Table.TransformColumns(#\"Renamed Columns\", {{\"ItemName\", Text.Trim, type text}}),",
                "    #\"Filtered Empty Rows\" = Table.SelectRows(#\"Trimmed Text\", each [ItemName] <> null and [ItemName] <> \"\"),",
                "    #\"Merged Products\" = Table.NestedJoin(#\"Filtered Empty Rows\", {\"ItemName\"}, Products, {\"ProductMatchLabel\"}, \"MatchedProduct\", JoinKind.LeftOuter),",
                "    #\"Expanded MatchedProduct\" = Table.ExpandTableColumn(#\"Merged Products\", \"MatchedProduct\", {\"ProductId\", \"Category\"}, {\"ProductId\", \"Category\"}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Expanded MatchedProduct\", {{\"ProductId\", Int64.Type}, {\"Category\", type text}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
