      {
        "name": "Validation_Scorecard",
        "columns": [
          {
            "name": "Metric",
            "dataType": "string",
            "lineageTag": "1b1b8a7a-7109-4595-8b23-711fc31bb3c1",
            "sourceColumn": "Metric"
          },
          {
            "name": "Value",
            "dataType": "int64",
            "formatString": "#,##0",
            "lineageTag": "e3d3d3a3-177a-418a-a9ae-777cfb667dbd",
            "sourceColumn": "Value"
          },
          {
            "name": "Status",
            "dataType": "string",
            "lineageTag": "e22ec7f3-5e28-4b8f-b4c6-d449aefaf85c",
            "sourceColumn": "Status"
          }
        ],
        "lineageTag": "14b946c5-3f3b-47de-a3e3-e369c50962bd",
        "partitions": [
          {
            "name": "Validation_Scorecard",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    BaseRowCount = Table.RowCount(TransactionItems),",
                "    MatchedRowCount = Table.RowCount(TransactionItems_Matched),",
                "    SqlBenchmark = 61973,",
                "    JoinRowVariance = MatchedRowCount - BaseRowCount,",
                "    BenchmarkVariance = BaseRowCount - SqlBenchmark,",
                "    ProductsGrouped = Table.Group(Products, {\"ProductMatchLabel\"}, {{\"LabelCount\", each Table.RowCount(_), Int64.Type}}),",
                "    DuplicateLabelsTable = Table.SelectRows(ProductsGrouped, each [LabelCount] > 1),",
                "    DuplicateLabelCount = Table.RowCount(DuplicateLabelsTable),",
                "    UnmatchedRows = Table.SelectRows(TransactionItems_Matched, each [ProductId] = null),",
                "    UnmatchedRowCount = Table.RowCount(UnmatchedRows),",
                "    DistinctUnmatchedCount = Table.RowCount(Table.Distinct(Table.SelectColumns(UnmatchedRows, {\"ItemName\"}))),",
                "    ScorecardTable = #table(type table [Metric = text, Value = Int64.Type, Status = text], {",
                "        {\"1. Base Row Count (TransactionItems)\", BaseRowCount, if BaseRowCount = SqlBenchmark then \"Matches SQL Benchmark\" else \"Discrepancy\"},",
                "        {\"2. Matched Row Count (TransactionItems_Matched)\", MatchedRowCount, if MatchedRowCount = BaseRowCount then \"Agrees with Base\" else \"Discrepancy\"},",
                "        {\"3. SQL Target Benchmark\", SqlBenchmark, \"Target Reference\"},",
                "        {\"4. Join Row Variance (Matched - Base)\", JoinRowVariance, if JoinRowVariance = 0 then \"Row Counts Agree\" else \"Join Row Count Discrepancy\"},",
                "        {\"5. Benchmark Variance (Base - SQL)\", BenchmarkVariance, if BenchmarkVariance = 0 then \"Matches SQL Benchmark\" else \"Benchmark Discrepancy\"},",
                "        {\"6. Catalogue Duplicate Labels\", DuplicateLabelCount, if DuplicateLabelCount = 0 then \"100% Unique Labels (No Fan-out)\" else \"Duplicates Found in Catalogue\"},",
                "        {\"7. Unmatched Rows (ProductId is null)\", UnmatchedRowCount, if UnmatchedRowCount = 0 then \"100% Matched\" else \"Unmatched Rows Found\"},",
                "        {\"8. Distinct Unmatched Item Names\", DistinctUnmatchedCount, if DistinctUnmatchedCount = 0 then \"None (Clean)\" else \"Review Unmatched Items\"}",
                "    })",
                "in",
