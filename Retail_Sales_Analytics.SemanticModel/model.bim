                "    Source = Csv.Document(File.Contents(\"E:\\\\Retail-Sales-Analytics\\\\data\\\\Products.csv\"), [Delimiter=\",\", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
