                "    #\"Added ProductMatchLabel\" = Table.AddColumn(#\"Changed Type\", \"ProductMatchLabel\", each let cleanName = Text.Trim(Text.From([ProductName])), rawVariant = if [Variant] = null then \"\" else Text.Trim(Text.From([Variant])) in if rawVariant = \"\" or rawVariant = \"-\" then cleanName else cleanName & \" (\" & rawVariant & \")\", type text)",
